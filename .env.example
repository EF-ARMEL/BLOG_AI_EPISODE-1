# Variables d'environnement pour le Blog de Nousdev

# Destinataire des messages du formulaire de contact
CONTACT_TO_EMAIL=adresse@exemple.com

# Configuration SMTP pour l'envoi d'e-mails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=adresse@exemple.com
SMTP_PASS= # À remplir en local, ne jamais versionner

# Expéditeur affiché dans l'e-mail
MAIL_FROM="Nousdev <adresse@exemple.com>"
